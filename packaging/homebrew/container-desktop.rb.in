# Homebrew cask for Container Desktop. Generated by scripts/make-cask.sh from
# packaging/homebrew/container-desktop.rb.in; edit the template, not this file.
cask "container-desktop" do
  version "@VERSION@"
  sha256 "@SHA256@"

  url "https://github.com/AIFlow-Labs-Limited/aiflowlabs-apple-containers-ui/releases/download/v#{version}/Container-Desktop-#{version}-arm64.dmg"
  name "Container Desktop"
  desc "Native dashboard for Apple's container runtime"
  homepage "https://github.com/AIFlow-Labs-Limited/aiflowlabs-apple-containers-ui"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on arch: :arm64
  depends_on macos: ">= :tahoe"

  app "Container Desktop.app"

  # The build is ad-hoc signed and not notarized, so Gatekeeper would block a quarantined copy.
  # The download was already checked against the sha256 above.
  postflight do
    system_command "/usr/bin/xattr",
                   args: ["-dr", "com.apple.quarantine", "#{appdir}/Container Desktop.app"]
  end

  uninstall quit: "io.aiflowlabs.containerdesktop"

  zap trash: [
    "~/Library/Application Support/Container Desktop",
    "~/Library/LaunchAgents/io.aiflowlabs.containerdesktop.supervisor.plist",
    "~/Library/Preferences/io.aiflowlabs.containerdesktop.plist",
  ]

  caveats <<~EOS
    Container Desktop is a dashboard for Apple's container runtime (@MIN_RUNTIME@ or later),
    which is installed separately:
      brew install container
    or download the installer from https://github.com/apple/container/releases/latest

    This build is ad-hoc signed and not notarized by Apple. So that it opens on first launch,
    this cask removes the macOS quarantine flag from the app after checking the download
    against its published SHA-256 checksum.
  EOS
end
